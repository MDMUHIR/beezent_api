# Beezents API environment configuration
# Copy this file to .env and adjust values as needed.
APP_NAME=Beezents API
APP_VERSION=0.1.0
DEBUG=false
API_V1_PREFIX=/api/v1

# PostgreSQL connection (async driver: postgresql+asyncpg)
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/beezents

# Authentication / session
# Name of the HTTP-only session cookie
SESSION_COOKIE_NAME=beezents_session
# Session lifetime in seconds (default: 7 days)
SESSION_MAX_AGE_SECONDS=604800
# Set to true in production (must be served over HTTPS)
COOKIE_SECURE=false