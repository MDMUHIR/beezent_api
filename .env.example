# Beezents API environment configuration
# Copy this file to .env and adjust values as needed.
APP_NAME=Beezents API
APP_VERSION=0.1.0
DEBUG=false
API_V1_PREFIX=/api/v1

# PostgreSQL connection (async driver: postgresql+asyncpg)
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/beezents

# Authentication / session
# Name of the HTTP-only session cookie
SESSION_COOKIE_NAME=beezents_session
# Session lifetime in seconds (default: 7 days)
SESSION_MAX_AGE_SECONDS=604800
# Set to true in production (must be served over HTTPS)
COOKIE_SECURE=false

# Media / file storage
# Storage backend name: "local" (dev). Future: "s3", "r2" (production object storage)
STORAGE_BACKEND=local
# Local backend directory for uploaded media (dev)
MEDIA_ROOT=./media
# Maximum accepted upload size in bytes (default: 10 MiB)
MEDIA_MAX_SIZE_BYTES=10485760

# API security
# Comma-separated allowed CORS origins. Empty = CORS disabled (same-origin/API clients).
# Required for the Next.js frontend when it runs on a different origin.
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# Comma-separated allowed Host header values. Set this in production.
# TRUSTED_HOSTS=localhost,127.0.0.1,beezents.com