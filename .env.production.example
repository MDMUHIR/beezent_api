# Beezents API — production configuration (AWS EC2).
# Copy to .env.production on the server and fill in real values.
# NEVER commit .env.production — keep it on the instance only.

APP_NAME=Beezents API
APP_VERSION=0.1.0
DEBUG=false
API_V1_PREFIX=/api/v1

# --- PostgreSQL (Amazon RDS or any managed PostgreSQL). Async driver required.
# The URL is assembled dynamically from the DB_* components below (each part
# can be configured/rotated independently). Set DATABASE_URL instead to use a
# full DSN verbatim — it takes precedence.
# RDS example:
#   DATABASE_URL=postgresql+asyncpg://beezents:CHANGE_ME@beezents-db.CLUSTER.ap-southeast-1.rds.amazonaws.com:5432/beezents
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=beezents

# --- Authentication / sessions
SESSION_COOKIE_NAME=beezents_session
SESSION_MAX_AGE_SECONDS=604800
# MUST be true in production — the session cookie is only transmitted over HTTPS.
COOKIE_SECURE=true

# --- Media / file storage
# Local backend on the instance's EBS volume (single-instance deployment).
# Use S3 / Cloudflare R2 behind the StorageBackend abstraction for a
# multi-instance or autoscaling topology.
STORAGE_BACKEND=local
MEDIA_ROOT=/app/media
MEDIA_MAX_SIZE_BYTES=10485760
MEDIA_MAX_VIDEO_SIZE_BYTES=104857600

# --- API security
# Comma-separated allowed CORS origins (your Next.js frontend origins).
CORS_ALLOWED_ORIGINS=https://www.example.com,https://example.com
# Comma-separated allowed Host header values — the domain of THIS API.
TRUSTED_HOSTS=api.example.com

# --- Production hardening: never auto-seed a development admin account.
SEED_DEV_ADMIN=false

# --- App server
# Keep this modest on small instances (1–2 on t3.micro, 2–4 on larger ones).
UVICORN_WORKERS=2