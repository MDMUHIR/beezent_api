# Application Settings
PROJECT_NAME="Beezent Headless CMS & API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# CORS Settings (Comma-separated list of origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agency_db
# Async Database URL for FastAPI & SQLAlchemy 2.0 AsyncSession:
# postgresql+asyncpg://postgres:postgres@localhost:5432/agency_db
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/agency_db"
# Synchronous URL for SQLAdmin & Alembic migrations:
SYNC_DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/agency_db"

# JWT Security
SECRET_KEY="super-secret-production-random-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Super Admin Seed Credentials
FIRST_SUPERUSER_EMAIL="admin@agency.com"
FIRST_SUPERUSER_PASSWORD="admin123"
